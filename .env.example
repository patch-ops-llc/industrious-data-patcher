# Copy to .env for local use (node --env-file=.env src/cli.js <command>), or set
# these as service variables in Railway. Never commit real values.

# --- Required ---------------------------------------------------------------
# HubSpot private app token for the Industrious portal. Scopes needed:
#   crm.objects.custom.read, crm.objects.custom.write, crm.schemas.custom.read,
#   crm.objects.deals.read, crm.objects.deals.write,
#   crm.objects.companies.read, crm.objects.companies.write
# For the one-time contact cleanup with the standard Contact part switched on,
# also crm.objects.contacts.read and crm.objects.contacts.write.
HUBSPOT_PRIVATE_APP_TOKEN=

# Staging database (Postgres).
# On Railway: reference the Postgres service in the same project:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally: a Postgres connection string (see docker-compose.yml), or
#   DATABASE_URL=pglite:./data/staging
# for an embedded database that needs no server (development only).
DATABASE_URL=
# disable (Railway's private network, local), require, or verify. Use require
# when connecting from outside Railway through the public database URL.
DATABASE_SSL=disable

# --- Safety -----------------------------------------------------------------
# Dry run is the default. Nothing is written to HubSpot until this is false
# (or a command is given --apply).
DRY_RUN=true

# --- Schedule ---------------------------------------------------------------
# Minutes between scheduled runs.
RUN_INTERVAL_MINUTES=30
# Every this many hours a scheduled run copies everything from HubSpot again
# and re-reads every association, instead of only what changed. 0 = never.
FULL_REFRESH_HOURS=24
# Each run re-reads this many minutes before the previous run's start.
CHANGE_OVERLAP_MINUTES=5
# Run history older than this is removed from the staging database. 0 = keep.
KEEP_RUNS_DAYS=90
# A run lock left by a process that died is taken over after this long.
RUN_LOCK_STALE_MINUTES=15

# --- Admin page (alert settings and last run status) -------------------------
# Password for the admin page, at least 12 characters. Without it the page is
# switched off; the service and the health check still run.
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12
# Railway sets PORT itself. Locally the page is on http://localhost:3000.
PORT=3000
# Only for trying the page locally over plain http. Never set on Railway.
ADMIN_INSECURE_COOKIE=false

# --- Failure alerts (email through Resend, Slack, both or neither) ------------
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
ALERT_EMAIL_FROM=
# First-time values only: recipients and repeat interval are kept in the
# staging database and edited on the admin page afterwards.
ALERT_EMAIL_TO=
ALERT_MIN_REPEAT_MINUTES=60
ALERT_SLACK_WEBHOOK_URL=

# --- Rarely changed ---------------------------------------------------------
# HubSpot API version: a date version (default 2026-09) or "legacy" for v3/v4 paths.
HUBSPOT_API_VERSION=2026-09
MAPPING_FILE=config/mapping.json
# Where the command line writes report files.
REPORTS_DIR=reports
LOG_LEVEL=info
